%% cheatsheet.sty -- layout, boxes, code listings and the self-locating grid index
%% for the PSTAT 131 midterm sheet.
%%
%% GRID INDEX
%%   Every page is cut into an invisible 8 x 11 grid: columns A-H (left to right,
%%   each 1/8 of the paper width) and rows 1-11 (top to bottom, each 1/11 of the
%%   paper height, i.e. one inch on letter paper).  \ix, \ixh, \ixc and \ixch
%%   record the exact spot of the term on the page *when the page is shipped out*
%%   (\pdfsavepos), so the index is always computed from the final layout -- edit
%%   anything, recompile, and every coordinate moves with the text.
%%
%%   Each location is written to <jobname>.idx as a single integer
%%       page*1000 + row*20 + col*2
%%   (steps of 2 so makeindex never merges neighbours into page ranges) and
%%   decoded back to "page:ColRow" (e.g. 12:C4) by \ixD / \ixR when the index is
%%   typeset.  \ixD = location in the distilled notes (bold blue),
%%   \ixR = location in the raw transcriptions (plain).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cheatsheet}[2026/10/26 PSTAT 131 midterm sheet]

